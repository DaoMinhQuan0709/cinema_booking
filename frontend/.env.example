# Copy file nay thanh ".env" (cung cap, Vite tu doc) va chinh lai gia tri neu can.

# Base URL cua REST API backend (Spring Boot), khop ARCHITECTURE.md / ke_hoach_backend.md
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Endpoint STOMP WebSocket goc cua backend; URL http/https cu van duoc tu dong chuyen doi.
VITE_WS_BASE_URL=ws://localhost:8080/ws

# Tuy chon: Google Maps Embed API key cong khai, can billing va HTTP referrer gioi han theo domain.
# De trong de dung OpenStreetMap khi rap co toa do; chi duong van dung duoc khi chi co dia chi.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
